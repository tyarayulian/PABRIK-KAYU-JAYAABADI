<script>
    function switchTab(type) {
        document.querySelectorAll('.nav-tab-item').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
        if(type === 'masuk') {
            document.querySelector('.nav-tab-item:first-child').classList.add('active');
            document.getElementById('tab-masuk').classList.add('active');
        } else {
            document.querySelector('.nav-tab-item:last-child').classList.add('active');
            document.getElementById('tab-keluar').classList.add('active');
        }
    }
</script>
